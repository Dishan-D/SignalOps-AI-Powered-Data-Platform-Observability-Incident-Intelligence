# Copy to .env and adjust. .env is gitignored — never commit real credentials.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
IMAGE_TAG=0.1.0

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# Base64-ish 22-char KRaft cluster id. Generate a fresh one with:
#   docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# Changing this after first start requires removing the kafka-data volume.
KAFKA_CLUSTER_ID=Nk018hRAQFytWskYqtQduw
KAFKA_EXTERNAL_PORT=29092

KAFKA_RAW_LOGS_TOPIC=logs.raw
KAFKA_NORMALIZED_TOPIC=logs.normalized
KAFKA_DLQ_TOPIC=logs.raw.dlq
KAFKA_ALERTS_TOPIC=alerts.anomalies
KAFKA_FEATURES_HOST_TOPIC=features.host_activity
KAFKA_FEATURES_PEER_TOPIC=features.peer_connections
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RETENTION_MS=604800000

# Delivery guarantees. 'all' + idempotence == no silent loss, no duplicates
# per partition. Lower them only if you can justify losing evidence.
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_COMPRESSION_TYPE=zstd

# Host-side clients (tests, scripts) use the external listener:
#   KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Containers use kafka:9092, injected by docker-compose.yml.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=forensics
POSTGRES_USER=forensics
# Required — Compose refuses to start without it. Use a real secret manager
# outside local development.
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Producer
# ---------------------------------------------------------------------------
PRODUCER_EVENTS_PER_SECOND=25
# 0 == run until stopped.
PRODUCER_MAX_EVENTS=0
# Target fraction of emitted events that belong to an attack campaign.
# Real-world base rates are far lower; 0.01-0.05 keeps the class imbalance
# realistic enough to be a meaningful test for the Phase 3 detector.
PRODUCER_ANOMALY_RATE=0.03
PRODUCER_HOST_COUNT=12
PRODUCER_USER_COUNT=25
# Set an integer for a reproducible stream; blank for fresh randomness.
PRODUCER_SEED=
# true == print events to stdout instead of publishing (no broker needed).
PRODUCER_DRY_RUN=false
PRODUCER_STATS_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------------
# Spark Structured Streaming (Phase 2)
# ---------------------------------------------------------------------------
# local[*] runs driver and executors in a single JVM, which is what you want on
# a laptop. Point at spark://spark-master:7077 for a real cluster — no code
# change is required.
SPARK_MASTER_URL=local[*]

# Where to begin on a FRESH checkpoint: earliest replays the retained topic,
# latest skips history. Ignored once a checkpoint exists — deleting the
# spark-checkpoints volume is the only way to change an existing job's position.
SPARK_STARTING_OFFSETS=earliest

# Caps a micro-batch. Without it, a job restarting against a large backlog tries
# to process the whole topic at once and runs out of memory.
SPARK_MAX_OFFSETS_PER_TRIGGER=50000
SPARK_TRIGGER_INTERVAL=10 seconds

# Default is 200, which on a laptop-sized stream means 200 near-empty tasks per
# micro-batch and more scheduling overhead than actual work.
SPARK_SHUFFLE_PARTITIONS=8

# How late an event may arrive and still count toward its window. Bounds the
# state store; append-mode results are held back by roughly this much.
SPARK_WATERMARK_DELAY=2 minutes
SPARK_WINDOW_DURATION=1 minute
SPARK_WINDOW_SLIDE=30 seconds

# Write normalised events to the evidence store via JDBC.
SPARK_POSTGRES_ENABLED=true
SPARK_POSTGRES_BATCH_SIZE=1000

SPARK_UI_PORT=4040

# ---------------------------------------------------------------------------
# Detection tier (Phase 3)
# ---------------------------------------------------------------------------
# Training is profile-gated (`make train`), not part of `make up`: it is an
# explicit act, not a side effect of starting the stack.
TRAINER_EPOCHS=30

# Event-level attack fraction in the TEST split only. Training and calibration
# are always benign-only. Real base rates are well under 1%.
TRAINER_TEST_ANOMALY_RATE=0.01

# Alert budget. Thresholds are calibrated to this on a benign holdout, so it is
# a statement about how many false alerts the team can absorb — which is
# answerable, unlike "what miss ratio counts as high".
SCORER_TARGET_FPR=0.01

SCORER_MODEL_VERSION=logbert-0.1.0
SCORER_CONSUMER_GROUP=forensics-scorer
SCORER_BATCH_SIZE=128
SCORER_FLUSH_INTERVAL_SECONDS=5
# Caps per-host buffers. An unbounded map of buffers leaks in any estate with
# container churn.
SCORER_MAX_TRACKED_HOSTS=5000
SCORER_POSTGRES_ENABLED=true

# ---------------------------------------------------------------------------
# Evidence ledger (Phase 4)
# ---------------------------------------------------------------------------
# Events are hashed the moment they are inserted, but only become
# tamper-evident once sealed into a chained block. This interval is therefore a
# security parameter: it bounds the window in which an attacker who can write to
# both evidence.events and ledger.event_digests could alter a record and
# recompute its digest undetected. `make ledger-status` reports the current
# unsealed count.
LEDGER_SEAL_INTERVAL_SECONDS=30
LEDGER_SEAL_BATCH_SIZE=10000

# The same loop drains evidence.raw_events (written by Spark) into the 3NF
# model. Nothing else invokes that transform, so disabling this leaves the
# landing table growing without bound and evidence.events empty.
LEDGER_NORMALIZE_ENABLED=true
LEDGER_NORMALIZE_BATCH_SIZE=10000

# Full verification rehashes every event, so it runs less often than sealing.
# Set to 0 to disable it and rely on `make ledger-verify` instead.
LEDGER_VERIFY_EVERY_CYCLES=20

# ---------------------------------------------------------------------------
# Optional tooling (docker compose --profile tools up -d)
# ---------------------------------------------------------------------------
KAFKA_UI_PORT=8080
